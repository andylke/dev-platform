(dev_tls) {
    tls /certificates/caddy.crt /certificates/caddy.key
}

{$SEAWEEDFS_S3_DOMAIN} {
    import dev_tls
    reverse_proxy seaweedfs:8333
}

{$MAILPIT_DOMAIN} {
    import dev_tls
    reverse_proxy mailpit:8025
}

{$VAULT_DOMAIN} {
    import dev_tls
    reverse_proxy vault:8200
}

{$JENKINS_DOMAIN} {
    import dev_tls
    reverse_proxy jenkins:8080
}

{$REGISTRY_DOMAIN} {
    import dev_tls
    reverse_proxy registry:5000
}

{$GRAFANA_DOMAIN} {
    import dev_tls
    reverse_proxy grafana:3000
}
