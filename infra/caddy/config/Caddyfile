(dev_tls) {
    tls /certificates/caddy.crt /certificates/caddy.key
}

{$MINIO_DOMAIN} {
    import dev_tls
    reverse_proxy minio:9000
}

{$MINIO_CONSOLE_DOMAIN} {
    import dev_tls
    reverse_proxy minio:9001
}

{$MAILPIT_DOMAIN} {
    import dev_tls
    reverse_proxy mailpit:8025
}

{$JENKINS_DOMAIN} {
    import dev_tls
    reverse_proxy jenkins:8080
}

{$GRAFANA_DOMAIN} {
    import dev_tls
    reverse_proxy grafana:3000
}
